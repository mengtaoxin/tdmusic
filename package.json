    "marked": "^18.0.13",
    "music-metadata": "^11.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "tdkit": "npm:@mengtaoxin/tdkit@^0.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
